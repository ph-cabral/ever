generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["fabrica"]
}

model personal {
  id        Int      @id @default(autoincrement())
  nombre    String
  dni       String?  @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  corte     corte[]

  @@schema("fabrica")
}

model manguera {
  id        Int      @id @default(autoincrement())
  codigo    String
  metros    Float    @default(0)
  ubicacion String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codigo])
  @@schema("fabrica")
}

model corte {
  id          Int      @id @default(autoincrement())
  metros      Float
  fecha       DateTime @default(now())
  observacion String?
  personalId  Int
  codigo      String
  personal    personal @relation(fields: [personalId], references: [id])

  @@index([fecha])
  @@index([personalId])
  @@schema("fabrica")
}
