generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["asistencia", "everwear", "fabrica", "preparado", "sistema"]
}

model personal {
  id        Int      @id @default(autoincrement())
  nombre    String
  dni       String?  @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  corte     corte[]

  @@schema("fabrica")
}

model manguera {
  id        Int      @id @default(autoincrement())
  codigo    String
  metros    Float    @default(0)
  ubicacion String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codigo])
  @@schema("fabrica")
}

model corte {
  id          Int       @id @default(autoincrement())
  metros      Float
  fecha       DateTime  @default(now())
  observacion String?
  personalId  Int?
  codigo      String
  trabajoId   Int?
  personal    personal? @relation(fields: [personalId], references: [id], onDelete: Restrict)
  trabajo     trabajo?  @relation(fields: [trabajoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fecha])
  @@index([personalId])
  @@index([trabajoId])
  @@schema("fabrica")
}

model picking_eventos {
  id             Int       @id @default(autoincrement())
  codigo         String    @db.VarChar(100)
  cantidad       Int
  picker_nombre  String    @db.VarChar(50)
  estado         String    @default("pendiente") @db.VarChar(20)
  respuesta_nota String?
  respondido_en  DateTime?
  creado_en      DateTime  @default(now())

  @@schema("preparado")
}

model picking_push_subs {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  activo    Boolean  @default(true)
  creado_en DateTime @default(now())

  @@schema("preparado")
}

model everwear_personal {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  area   String  @db.VarChar(50)
  activo Boolean @default(true)
  legajo legajo?

  @@map("personal")
  @@schema("everwear")
}

model chat_mensajes {
  id            Int       @id @default(autoincrement())
  picker_nombre String    @db.VarChar(100)
  mensaje       String
  respuesta     String?
  respondido    Boolean?  @default(false)
  creado_en     DateTime? @default(now()) @db.Timestamp(6)

  @@schema("preparado")
}

model legajo {
  id                     Int                      @id @default(autoincrement())
  codigo                 String?                  @unique
  estado                 String                   @default("draft") @db.VarChar(20)
  personalId             Int?                     @unique
  nombre                 String                   @db.VarChar(100)
  dni                    String?                  @unique @db.VarChar(20)
  cuil                   String?                  @db.VarChar(20)
  fechaNacimiento        DateTime?                @db.Date
  lugarNacimiento        String?                  @db.VarChar(150)
  nacionalidad           String?                  @default("Argentina") @db.VarChar(60)
  sexo                   String                   @db.VarChar(2)
  estadoCivil            String?                  @db.VarChar(20)
  altura                 Float?
  peso                   Float?
  manoHabil              String?                  @db.VarChar(20)
  telefonoFijo           String?                  @db.VarChar(40)
  telefonoCelular        String?                  @db.VarChar(40)
  emailPersonal          String?                  @db.VarChar(150)
  antecedentesPenales    Boolean                  @default(false)
  antecedentesDetalle    String?
  aceptaPsicotecnico     Boolean                  @default(false)
  calle                  String?                  @db.VarChar(150)
  numero                 String?                  @db.VarChar(20)
  piso                   String?                  @db.VarChar(10)
  depto                  String?                  @db.VarChar(10)
  codigoPostal           String?                  @db.VarChar(10)
  localidad              String?                  @db.VarChar(100)
  provincia              String?                  @db.VarChar(60)
  comprobanteUrl         String?
  ddjjConformidad        Boolean                  @default(false)
  fechaInicio            DateTime?                @db.Date
  fechaCese              DateTime?                @db.Date
  modalidadContrato      String?                  @db.VarChar(100)
  situacionRevista       String?                  @db.VarChar(20)
  regimen                String?                  @db.VarChar(40)
  convenio               String?                  @db.VarChar(100)
  categoria              String?                  @db.VarChar(100)
  puestoInterno          String?                  @db.VarChar(100)
  sector                 String?                  @db.VarChar(60)
  retribucionPactada     Float?
  modalidadLiquidacion   String?                  @db.VarChar(20)
  obraSocial             String?                  @db.VarChar(100)
  tipoServicio           String?                  @db.VarChar(100)
  actividadEconomica     String?                  @db.VarChar(100)
  domicilioExplotacion   String?                  @db.VarChar(200)
  claveAltaArca          String?                  @db.VarChar(40)
  fechaEnvioAlta         DateTime?
  banco                  String?                  @db.VarChar(40)
  bancoOtro              String?                  @db.VarChar(60)
  diaPago                Int?
  percibeSeguroDesempleo Boolean?                 @default(false)
  ddjjArt12              Boolean                  @default(false)
  tieneCargasFamilia     Boolean?                 @default(false)
  medioPagoAaff          String?                  @db.VarChar(40)
  medioPagoAaffOtro      String?                  @db.VarChar(100)
  estatura               Float?
  pesoSalud              Float?
  presionMin             Int?
  presionMax             Int?
  patologiaNervioso      Boolean                  @default(false)
  patologiaRespiratorio  Boolean                  @default(false)
  patologiaCirculatorio  Boolean                  @default(false)
  patologiaDigestivo     Boolean                  @default(false)
  patologiaRenal         Boolean                  @default(false)
  patologiaOseo          Boolean                  @default(false)
  patologiaSangre        Boolean                  @default(false)
  patologiaCancer        Boolean                  @default(false)
  patologiaCongenitas    Boolean                  @default(false)
  patologiaEndocrinas    Boolean                  @default(false)
  patologiaGinecologicas Boolean                  @default(false)
  patologiaEmbarazo      Boolean                  @default(false)
  patologiaOtras         Boolean                  @default(false)
  patologiaChagas        Boolean                  @default(false)
  observacionesSalud     String?
  numeroSolicitud        String?                  @db.VarChar(60)
  numeroPoliza           String?                  @db.VarChar(60)
  capitalAsegurado       Float?
  fechaIngresoEmpleo     DateTime?                @db.Date
  artCompania            String?                  @db.VarChar(80)
  artNumeroContrato      String?                  @db.VarChar(60)
  artCredencialEntregada Boolean                  @default(false)
  aceptaClausulas        Boolean                  @default(false)
  jurisdiccion           String                   @default("San Francisco, Córdoba") @db.VarChar(100)
  firmaEmpleado          String?
  fechaFirma             DateTime?                @db.Date
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  employeeNo             String?                  @unique @db.VarChar(50)
  sectorId               Int?
  anvizId                String?                  @unique @db.VarChar(20)
  personal               everwear_personal?       @relation(fields: [personalId], references: [id])
  sectorRel              sector?                  @relation(fields: [sectorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  antecedentesSrt        legajo_antecedente_srt[]
  beneficiarios          legajo_beneficiario[]
  equipos                legajo_equipo[]
  estudios               legajo_estudio[]
  familiares             legajo_familiar[]
  idiomas                legajo_idioma[]
  usuario                usuario?
  trabajos               trabajo[]

  @@index([estado])
  @@schema("everwear")
}

model legajo_familiar {
  id              Int      @id @default(autoincrement())
  legajoId        Int
  parentesco      String   @db.VarChar(20)
  apellido        String   @db.VarChar(100)
  nombre          String   @db.VarChar(100)
  tipoDocumento   String   @default("DNI") @db.VarChar(10)
  numeroDocumento String   @db.VarChar(20)
  fechaNacimiento DateTime @db.Date
  nacionalidad    String   @default("Argentina") @db.VarChar(60)
  telefono        String?  @db.VarChar(40)
  ocupacion       String?  @db.VarChar(100)
  convive         Boolean  @default(false)
  legajo          legajo   @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_beneficiario {
  id              Int    @id @default(autoincrement())
  legajoId        Int
  apellidoNombre  String @db.VarChar(200)
  tipoDocumento   String @default("DNI") @db.VarChar(10)
  numeroDocumento String @db.VarChar(20)
  parentesco      String @db.VarChar(40)
  domicilio       String @db.VarChar(200)
  porcentaje      Float
  legajo          legajo @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_estudio {
  id          Int     @id @default(autoincrement())
  legajoId    Int
  nivel       String  @db.VarChar(20)
  institucion String  @db.VarChar(200)
  desde       String  @db.VarChar(10)
  hasta       String? @db.VarChar(10)
  titulo      String? @db.VarChar(200)
  enCurso     Boolean @default(false)
  legajo      legajo  @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_idioma {
  id        Int    @id @default(autoincrement())
  legajoId  Int
  idioma    String @db.VarChar(60)
  habla     String @db.VarChar(20)
  escritura String @db.VarChar(20)
  legajo    legajo @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_equipo {
  id            Int      @id @default(autoincrement())
  legajoId      Int
  tipo          String   @db.VarChar(30)
  marca         String   @db.VarChar(60)
  modelo        String   @db.VarChar(100)
  detalle       String?
  numeroSerie   String   @db.VarChar(80)
  fechaEntrega  DateTime @db.Date
  estado        String   @db.VarChar(10)
  observaciones String?
  legajo        legajo   @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model legajo_antecedente_srt {
  id            Int       @id @default(autoincrement())
  legajoId      Int
  descripcion   String    @db.VarChar(300)
  fecha         DateTime? @db.Date
  observaciones String?
  legajo        legajo    @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  @@index([legajoId])
  @@schema("everwear")
}

model asistencia_evento {
  id            BigInt    @id @default(autoincrement())
  device        String    @db.VarChar(50)
  employee_no   String    @db.VarChar(50)
  employee_name String?   @db.VarChar(200)
  event_time    DateTime  @db.Timestamptz(6)
  major         Int?
  minor         Int?
  card_no       String?   @db.VarChar(50)
  tipo          String?   @db.VarChar(20)
  job_id        BigInt?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([employee_no, event_time, device])
  @@index([employee_no, event_time])
  @@index([job_id])
  @@index([employee_no, event_time], map: "idx_evento_emp_fecha")
  @@index([job_id], map: "idx_evento_job")
  @@map("evento")
  @@schema("asistencia")
}

model asistencia_resumen_diario {
  id            BigInt    @id @default(autoincrement())
  employee_no   String    @db.VarChar(50)
  employee_name String?   @db.VarChar(200)
  fecha         DateTime  @db.Date
  check_in      DateTime? @db.Timestamptz(6)
  check_out     DateTime? @db.Timestamptz(6)
  minutos       Int?
  eventos_dia   Int?
  devices       String?
  job_id        BigInt?

  @@unique([employee_no, fecha])
  @@index([fecha])
  @@index([fecha], map: "idx_resumen_fecha")
  @@map("resumen_diario")
  @@schema("asistencia")
}

model job {
  id            BigInt    @id @default(autoincrement())
  start_ts      DateTime  @db.Timestamptz(6)
  end_ts        DateTime  @db.Timestamptz(6)
  status        String?   @default("running") @db.VarChar(20)
  eventos_raw   Int?
  eventos_ok    Int?
  resumen_filas Int?
  error_msg     String?
  duracion_seg  Float?    @db.Real
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("asistencia")
}

model user_id_registry {
  id           Int       @id @default(autoincrement())
  external_ref String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("everwear")
}

model area {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  sectores  sector[]

  @@schema("everwear")
}

model sector {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(80)
  areaId    Int
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  legajos   legajo[]
  area      area      @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trabajos  trabajo[]

  @@unique([nombre, areaId])
  @@index([areaId])
  @@schema("everwear")
}

model cliente {
  numero    Int       @id
  nombre    String    @db.VarChar(150)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  trabajo   trabajo[]

  @@schema("everwear")
}

model trabajo {
  id                  Int       @id @default(autoincrement())
  fechaPedido         DateTime  @default(now()) @db.Timestamp(6)
  pedidoTransferencia String?   @db.VarChar(60)
  ordenTrabajo        String?   @db.VarChar(60)
  prioridad           String?   @db.VarChar(20)
  producto            String?   @db.VarChar(80)
  cantidadAProducir   Float?
  observaciones       String?
  estado              String    @default("EN_PROCESO") @db.VarChar(20)
  legajoId            Int
  sectorId            Int?
  clienteNumero       Int?
  inicio              DateTime  @default(now()) @db.Timestamp(6)
  fin                 DateTime? @db.Timestamp(6)
  createdAt           DateTime  @default(now()) @db.Timestamp(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  clienteNombre       String?   @db.VarChar(150)
  cortes              corte[]
  cliente             cliente?  @relation(fields: [clienteNumero], references: [numero], onDelete: NoAction, onUpdate: NoAction)
  legajo              legajo    @relation(fields: [legajoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sector              sector?   @relation(fields: [sectorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([legajoId])
  @@index([estado])
  @@schema("fabrica")
}

model sorteo_ronda {
  id         Int            @id @default(autoincrement())
  titulo     String?
  estado     String         @default("armado")
  instancias Json?
  createdAt  DateTime       @default(now()) @db.Timestamp(6)
  album      sorteo_album[]

  @@schema("everwear")
}

model sorteo_album {
  id        Int          @id @default(autoincrement())
  rondaId   Int
  orden     Int
  instancia Int          @default(0)
  dni       String
  nombre    String
  marco     String       @default("oro")
  premio    String?
  premioImg String?
  createdAt DateTime     @default(now()) @db.Timestamp(6)
  ronda     sorteo_ronda @relation(fields: [rondaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rondaId, dni], map: "sorteo_album_rondaid_dni_key")
  @@unique([rondaId, orden], map: "sorteo_album_rondaid_orden_key")
  @@index([rondaId], map: "sorteo_album_rondaid_idx")
  @@schema("everwear")
}

model faltante_existencia {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @db.Date
  nroPedOrigen   Int      @map("nro_ped_origen")
  nroRengOrigen  Int      @map("nro_reng_origen")
  codArticulo    String?  @map("cod_articulo") @db.VarChar(50)
  existencia     Boolean?
  creado_en      DateTime @default(now()) @db.Timestamp(6)
  actualizado_en DateTime @default(now()) @updatedAt @db.Timestamp(6)
  cantidad       Float?

  @@unique([fecha, nroPedOrigen, nroRengOrigen], name: "uniq_faltante", map: "uniq_faltante")
  @@schema("preparado")
}

model usuario {
  id           Int       @id @default(autoincrement())
  legajoId     Int       @unique
  dni          String    @unique @db.VarChar(20)
  nombre       String    @db.VarChar(100)
  passwordHash String
  rol          String    @default("USUARIO") @db.VarChar(20)
  sector       String?   @db.VarChar(80)
  activo       Boolean   @default(true)
  ultimoAcceso DateTime? @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  legajo       legajo    @relation(fields: [legajoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([dni])
  @@schema("everwear")
}

model sector_permiso {
  id        Int      @id @default(autoincrement())
  sector    String   @unique @db.VarChar(80)
  modulos   Json     @default("[]")
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  vistas    Json     @default("[]")
  ocultos   Json     @default("[]")

  @@schema("everwear")
}

model sistema_tablero {
  id              Int                      @id @default(autoincrement())
  clave           String                   @unique @db.VarChar(40)
  nombre          String                   @db.VarChar(100)
  createdAt       DateTime                 @default(now()) @db.Timestamp(6)
  columnasOcultas sistema_columna_oculta[]
  tarjetas        sistema_tarjeta[]        @relation("tarjetaTablero")

  @@schema("sistema")
}

model sistema_columna {
  id        Int                      @id @default(autoincrement())
  nombre    String                   @unique @db.VarChar(100)
  orden     Int                      @default(0)
  createdAt DateTime                 @default(now()) @db.Timestamp(6)
  ocultaEn  sistema_columna_oculta[]
  tarjetas  sistema_tarjeta[]

  @@schema("sistema")
}

model sistema_columna_oculta {
  tableroId Int
  columnaId Int
  columna   sistema_columna @relation(fields: [columnaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tablero   sistema_tablero @relation(fields: [tableroId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tableroId, columnaId])
  @@schema("sistema")
}

model sistema_tarjeta {
  id        Int             @id @default(autoincrement())
  columnaId Int
  orden     Int             @default(0)
  campos    Json            @default("{}")
  createdAt DateTime        @default(now()) @db.Timestamp(6)
  updatedAt DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  tableroId Int
  columna   sistema_columna @relation(fields: [columnaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tablero   sistema_tablero @relation("tarjetaTablero", fields: [tableroId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sistema_tarjeta_tablero_fk")

  @@index([columnaId], map: "idx_sistema_tarjeta_columna")
  @@index([tableroId], map: "idx_sistema_tarjeta_tablero")
  @@schema("sistema")
}

model sistema_opcion {
  id        Int      @id @default(autoincrement())
  clave     String   @db.VarChar(40)
  campo     String   @db.VarChar(50)
  valor     String   @db.VarChar(150)
  orden     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([clave, campo, valor])
  @@schema("sistema")
}

model estado_diario {
  id          BigInt   @id @default(autoincrement())
  employee_no String   @db.VarChar(50)
  fecha       DateTime @db.Date
  estado      String?  @db.VarChar(40)
  dias        Int?
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([employee_no, fecha], map: "estado_diario_emp_fecha_uk")
  @@index([fecha], map: "idx_estado_diario_fecha")
  @@schema("asistencia")
}

model novedad_diaria {
  id             BigInt   @id @default(autoincrement())
  employee_no    String   @db.VarChar(50)
  fecha          DateTime @db.Date
  novedad        String?  @db.VarChar(40)
  horas          Int?
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  minutos_brutos Int?
  minutos_netos  Int?
  minutos_rrhh   Int?
  novedades      Json     @default("[]")

  @@unique([employee_no, fecha], map: "novedad_diaria_emp_fecha_uk")
  @@index([fecha], map: "idx_novedad_diaria_fecha")
  @@schema("asistencia")
}

model faltante_control {
  id            Int       @id @default(autoincrement())
  fecha         DateTime  @db.Date
  nroPedOrigen  Int
  nroRengOrigen Int
  codArticulo   String    @default("")
  fechaArribo   DateTime? @db.Date
  clienteQuiere Boolean?
  updatedAt     DateTime  @default(now()) @db.Timestamptz(6)
  vendido       Boolean?
  vendidoAt     DateTime? @db.Timestamptz(6)
  irrelevante   Boolean?
  irrelevanteAt DateTime? @db.Timestamptz(6)

  @@unique([fecha, nroPedOrigen, nroRengOrigen], map: "uniq_faltante_control")
  @@index([fecha], map: "idx_faltante_control_fecha")
  @@schema("preparado")
}

model faltante_extraordinario {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @db.Date
  codArticulo    String   @default("")
  extraordinario Boolean  @default(false)
  comprar        Boolean?
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([fecha, codArticulo], map: "uniq_faltante_extraordinario")
  @@index([fecha], map: "idx_faltante_extraordinario_fecha")
  @@schema("preparado")
}

model faltante_novedad {
  id                    Int                    @id @default(autoincrement())
  fecha                 DateTime               @db.Date
  nroPedOrigen          Int
  nroRengOrigen         Int
  codArticulo           String                 @default("")
  novedadId             Int?
  updatedAt             DateTime               @default(now()) @db.Timestamptz(6)
  faltante_novedad_tipo faltante_novedad_tipo? @relation(fields: [novedadId], references: [id], onUpdate: NoAction)

  @@unique([fecha, nroPedOrigen, nroRengOrigen], map: "uniq_faltante_novedad")
  @@index([fecha], map: "idx_faltante_novedad_fecha")
  @@schema("preparado")
}

model faltante_novedad_tipo {
  id               Int                @id @default(autoincrement())
  nombre           String             @unique
  orden            Int                @default(0)
  activo           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  faltante_novedad faltante_novedad[]

  @@schema("preparado")
}

model faltante_oc_consumo {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @db.Date
  codArticulo String   @default("")
  faltan      Decimal  @default(0) @db.Decimal(14, 2)
  ocImputada  Decimal  @default(0) @db.Decimal(14, 2)
  descubierto Decimal  @default(0) @db.Decimal(14, 2)
  ocTotal     Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([fecha, codArticulo], map: "uniq_faltante_oc_consumo")
  @@index([fecha], map: "idx_faltante_oc_consumo_fecha")
  @@schema("preparado")
}

model faltante_wms {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  otId          Int
  renglon       Int
  nroPedOrigen  Int?
  nroRengOrigen Int
  operario      String   @default("")
  cliente       String   @default("")
  vendedor      String   @default("")
  ubicacion     String   @default("")
  codArticulo   String   @default("")
  cantPedida    Decimal  @default(0) @db.Decimal(14, 2)
  cantCumplida  Decimal  @default(0) @db.Decimal(14, 2)
  diferencia    Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([otId, renglon], map: "uniq_faltante_wms")
  @@index([fecha], map: "idx_faltante_wms_fecha")
  @@index([nroPedOrigen, nroRengOrigen], map: "idx_faltante_wms_ped")
  @@schema("preparado")
}
